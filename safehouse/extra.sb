;; Python multiprocessing (djlint, pytest-xdist, ruff, etc.) creates POSIX named
;; semaphores via sem_open; safehouse's deny-default policy has no ipc-posix-sem
;; allow, so SemLock.__init__ fails with EPERM. SysV semaphores are already
;; allowed for LMDB but multiprocessing on macOS uses the POSIX variant.
(allow ipc-posix-sem)

;; libfaketime's ft_shm_create() calls shm_open("/faketime_shm_<pid>"); same
;; deny-default gap as the semaphores above, so time-faking tests die at startup.
(allow ipc-posix-shm)

;; This machine's ssh-agent SSH_AUTH_SOCK lives under /var/run (→ /private/var/run),
;; but safehouse's ssh integration only whitelists the /tmp and /private/tmp launchd
;; Listeners variants. Since it also denies reading ~/.ssh private keys, the agent
;; socket is the only auth path, so SSH git clones fail with publickey denied without this.
(allow file-read* file-write*
    (regex #"^/private/var/run/com\.apple\.launchd\.[^/]+/Listeners$")
    (regex #"^/var/run/com\.apple\.launchd\.[^/]+/Listeners$")
)
(allow network-outbound
    (remote unix-socket (path-regex #"^/private/var/run/com\.apple\.launchd\.[^/]+/Listeners$"))
    (remote unix-socket (path-regex #"^/var/run/com\.apple\.launchd\.[^/]+/Listeners$"))
)
