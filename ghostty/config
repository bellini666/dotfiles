font-family = "Hack Nerd Font"
font-size = 13
adjust-cell-height = 2
adjust-cell-width = "2%"

theme = "Kanagawa Wave"

font-thicken = true
font-thicken-strength = 150

working-directory = home
window-inherit-working-directory = true
quit-after-last-window-closed = true

macos-option-as-alt = left
macos-titlebar-style = tabs
window-colorspace = "display-p3"

shell-integration = zsh

keybind = alt+right=unbind
keybind = alt+left=unbind
# CSI-u for ctrl+alt+k: macOS terminals never forward cmd, so herdr binds this chord instead
keybind = cmd+k=text:\x1b[107;7u

shell-integration-features = ssh-terminfo,ssh-env,cursor,sudo,title

auto-update = check
auto-update-channel = stable

# >>> herdr-radar font block
font-codepoint-map = U+E1A0-U+E1BA=Herdr Agent Icons Max
font-codepoint-map = U+E1C0-U+E1C5=Herdr Agent Icons Max
# <<< herdr-radar font block
